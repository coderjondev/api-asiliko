# =========================================================
# APPLICATION
# =========================================================

NODE_ENV=production
PORT=5000

APP_NAME=ai-service-api
APP_URL=https://api.example.com
API_VERSION=v1

# Frontend / Admin Panel
CLIENT_URL=https://app.example.com
ADMIN_URL=https://admin.example.com

# Multiple origins if needed
CORS_ORIGINS=https://app.example.com,https://admin.example.com


# =========================================================
# DATABASE — MongoDB
# =========================================================

MONGO_URI=mongodb+srv://USERNAME:PASSWORD@HOST/ai_service_db


# =========================================================
# AUTHENTICATION
# =========================================================

JWT_SECRET=GENERATE_A_LONG_RANDOM_SECRET
JWT_EXPIRES_IN=7d

# Optional separate secret for other application-level auth
AUTH_SECRET=GENERATE_ANOTHER_LONG_RANDOM_SECRET

# Used for encrypting sensitive data stored in DB
ENCRYPTION_KEY=GENERATE_32_BYTE_SECRET


# =========================================================
# ADMIN
# =========================================================

DEFAULT_ADMIN_EMAIL=admin@example.com
DEFAULT_ADMIN_PASSWORD=CHANGE_THIS_AFTER_FIRST_LOGIN

# Admin session/token configuration
ADMIN_JWT_EXPIRES_IN=1d


# =========================================================
# AI PROVIDERS
# =========================================================

# Google Gemini
GEMINI_API_KEY=

# DeepSeek
DEEPSEEK_API_KEY=

# OpenAI — optional
OPENAI_API_KEY=

# Anthropic — optional
ANTHROPIC_API_KEY=

# OpenRouter — optional
OPENROUTER_API_KEY=

# Groq — optional
GROQ_API_KEY=

# Mistral — optional
MISTRAL_API_KEY=


# =========================================================
# AI CONFIGURATION
# =========================================================

DEFAULT_AI_PROVIDER=deepseek
DEFAULT_AI_MODEL=deepseek-v4-pro

# Daily AI request limit per user
AI_DAILY_LIMIT=20

# Maximum tokens allowed per request
AI_MAX_OUTPUT_TOKENS=4096

# Request timeout
AI_REQUEST_TIMEOUT_MS=120000

# Enable streaming responses
ENABLE_STREAMING=true

# AI features
ENABLE_RAG=true
ENABLE_TOOLS=true
ENABLE_FUNCTION_CALLING=true


# =========================================================
# REDIS — UPSTASH
# =========================================================

UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=


# =========================================================
# GLOBAL RATE LIMITING
# =========================================================

RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX_REQUESTS=100


# =========================================================
# AI RATE LIMITING
# =========================================================

AI_RATE_LIMIT_WINDOW_MS=60000
AI_RATE_LIMIT_MAX_REQUESTS=5


# =========================================================
# API KEY SYSTEM
# =========================================================

# User-generated API keys
API_KEY_PREFIX=sk_

# Number of characters shown when displaying a key
API_KEY_PREVIEW_LENGTH=8

# API key expiration in days
API_KEY_EXPIRES_IN_DAYS=365


# =========================================================
# USAGE / QUOTA
# =========================================================

ENABLE_USAGE_TRACKING=true
ENABLE_TOKEN_TRACKING=true

# Maximum requests per user per day
DEFAULT_DAILY_REQUEST_LIMIT=20

# Maximum requests per user per month
DEFAULT_MONTHLY_REQUEST_LIMIT=1000


# =========================================================
# RAG / EMBEDDINGS
# =========================================================

EMBEDDING_PROVIDER=
EMBEDDING_MODEL=

# Pinecone
PINECONE_API_KEY=
PINECONE_INDEX=

# Qdrant
QDRANT_URL=
QDRANT_API_KEY=
QDRANT_COLLECTION=


# =========================================================
# FILE / OBJECT STORAGE
# =========================================================

S3_ENDPOINT=
S3_REGION=
S3_BUCKET=
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=

# Maximum uploaded file size in MB
MAX_FILE_SIZE_MB=25


# =========================================================
# EMAIL
# =========================================================

RESEND_API_KEY=
EMAIL_FROM=no-reply@example.com

# Optional
EMAIL_REPLY_TO=


# =========================================================
# PAYMENTS
# =========================================================

STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=

# Optional Stripe configuration
STRIPE_PUBLISHABLE_KEY=


# =========================================================
# WEBHOOKS
# =========================================================

WEBHOOK_SECRET=


# =========================================================
# SECURITY
# =========================================================

# Cookie settings
COOKIE_SECURE=true
COOKIE_SAME_SITE=lax

# CSRF protection if using cookie authentication
ENABLE_CSRF=true

# Trust proxy when running behind Nginx / Cloudflare / load balancer
TRUST_PROXY=true


# =========================================================
# LOGGING / MONITORING
# =========================================================

LOG_LEVEL=info

# Sentry
SENTRY_DSN=

# Enable request logging
ENABLE_REQUEST_LOGGING=true

# Enable audit logs
ENABLE_AUDIT_LOGGING=true


# =========================================================
# FEATURE FLAGS
# =========================================================

ENABLE_REGISTRATION=true
ENABLE_EMAIL_VERIFICATION=false
ENABLE_PASSWORD_RESET=true

ENABLE_CHAT_HISTORY=true
ENABLE_FILE_UPLOADS=true
ENABLE_WEB_SEARCH=false

ENABLE_ADMIN_PANEL=true
ENABLE_API_KEYS=true
ENABLE_BILLING=false


# =========================================================
# PAGINATION / API DEFAULTS
# =========================================================

DEFAULT_PAGE_SIZE=20
MAX_PAGE_SIZE=100

# Request body limits
JSON_BODY_LIMIT=2mb


# =========================================================
# ENVIRONMENT / DEBUG
# =========================================================

DEBUG=false